    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queued requests",
      "description": "Requests waiting in each node's bounded executor queue; a full queue rejects new requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
