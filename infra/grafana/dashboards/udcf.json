{
  "uid": "udcf-cluster",
  "title": "UDCF cluster",
  "description": "Live per-node metrics of the UDCF cluster, scraped from /actuator/prometheus every 5 s. Every distributed_* series carries node_id (R5).",
  "tags": [
    "udcf"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cluster overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Node status",
      "description": "distributed_node_status per node: Up while the node runs, Down after a crash (visible within one 5 s scrape).",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "max by (node_id) (distributed_node_status)",
          "legendFormat": "node {{node_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Events per second",
      "description": "Cluster events published on the shared event bus per second, and WebSocket notifications dropped (cluster level, node_id 0).",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum(rate(distributed_events_published_total[30s]))",
          "legendFormat": "published",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum(rate(distributed_event_notifications_dropped_total[30s]))",
          "legendFormat": "notifications dropped",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Heap of the one backend JVM that hosts every node (R1), so this panel is process-wide, not per node.",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})",
          "legendFormat": "committed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Multithreading (Experiment 2)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Completed requests per second",
      "description": "Each node executor's completed requests per second over its 30 s sliding window; no value while the executor is not running.",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "distributed_request_throughput",
          "legendFormat": "node {{node_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active worker threads",
      "description": "Worker threads currently executing a request, per node (thread caps follow capacity: FAST 4, MEDIUM 2, SLOW 1).",
