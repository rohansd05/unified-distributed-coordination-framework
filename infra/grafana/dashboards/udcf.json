    {
      "id": 13,
      "type": "bargauge",
      "title": "Elections won per node",
      "description": "Elected rounds by the winning node since the backend started; after a leader crash the new leader gains one (trigger LEADER_FAILURE).",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum by (node_id) (distributed_leader_elections_total)",
          "legendFormat": "node {{node_id}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Elections won by trigger",
      "description": "The same counter over time, by winner and trigger; a step up marks a finished election round.",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum by (node_id, trigger) (distributed_leader_elections_total)",
          "legendFormat": "node {{node_id}} {{trigger}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
