        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejected requests per second",
      "description": "Submissions refused because the node's queue was full (distributed_requests_total, outcome rejected).",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "sum by (node_id) (rate(distributed_requests_total{outcome=\"rejected\"}[30s]))",
          "legendFormat": "node {{node_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
