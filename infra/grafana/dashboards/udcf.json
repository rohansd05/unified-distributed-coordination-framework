        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Election duration (recent max)",
      "description": "Longest measured round, from its start (or the failure detection) until every live node agreed, in a rolling window of about 2 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "udcf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "udcf-prometheus"
          },
          "expr": "max by (algorithm, trigger) (distributed_election_duration_seconds_max)",
