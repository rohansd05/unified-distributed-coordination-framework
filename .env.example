# ============================================================================
# Unified Distributed Coordination Framework — Environment Configuration
#
# Copy this file to .env and adjust values for your machine:
#     cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
#
# IMPORTANT: every value here points at localhost or your own LAN.
# This project uses NO cloud services and requires NO external accounts,
# API keys or internet-hosted endpoints.
# ============================================================================


# ---------------------------------------------------------------------------
# Database (PostgreSQL — installed natively on your machine)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=udcf
POSTGRES_USER=udcf_user
POSTGRES_PASSWORD=change_me_locally

# Full JDBC URL assembled from the above; override only if unusual
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/udcf


# ---------------------------------------------------------------------------
# Instance Ports
# ---------------------------------------------------------------------------
GATEWAY_PORT=8080
NODE1_PORT=8081
NODE2_PORT=8082
NODE3_PORT=8083
FRONTEND_PORT=5173


# ---------------------------------------------------------------------------
# Node Addresses
#
# SINGLE MACHINE: leave these as localhost.
# LAN DEPLOYMENT: replace with the actual IPv4 address of each machine,
#                 e.g. NODE2_HOST=192.168.1.42
# ---------------------------------------------------------------------------
GATEWAY_HOST=localhost
NODE1_HOST=localhost
NODE2_HOST=localhost
NODE3_HOST=localhost


# ---------------------------------------------------------------------------
# Java RMI (Experiments 9 and 10 only)
# ---------------------------------------------------------------------------
RMI_NODE1_PORT=1101
RMI_NODE2_PORT=1102
RMI_NODE3_PORT=1103


# ---------------------------------------------------------------------------
# Thread Pool Defaults (Experiment 2)
# Per-node overrides live in the profile YAML files.
# ---------------------------------------------------------------------------
THREADPOOL_CORE_SIZE=4
THREADPOOL_MAX_SIZE=8
THREADPOOL_QUEUE_CAPACITY=200
THREADPOOL_METRICS_WINDOW_SECONDS=30


# ---------------------------------------------------------------------------
# Cluster Behaviour
# ---------------------------------------------------------------------------
HEARTBEAT_INTERVAL_MS=2000
HEARTBEAT_TIMEOUT_MS=6000
PEER_PROBE_TIMEOUT_MS=2000
ELECTION_TIMEOUT_MS=5000
REPLICATION_TIMEOUT_MS=3000


# ---------------------------------------------------------------------------
# Monitoring (Docker containers on your machine)
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090

GRAFANA_PORT=3000
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_locally


# ---------------------------------------------------------------------------
# Frontend (Vite — only VITE_* variables reach the browser)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws
VITE_GRAFANA_URL=http://localhost:3000
VITE_NODE1_URL=http://localhost:8081
VITE_NODE2_URL=http://localhost:8082
VITE_NODE3_URL=http://localhost:8083


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL_UDCF=INFO
LOG_LEVEL_ROOT=WARN